{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "express-rspack-rest-api",
  "main": "src/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2025-09-03",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules",
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
}

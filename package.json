{
  "name": "express-api",
  "version": "1.0.0",
  "description": "Express & Rspack API",
  "author": "https://github.com/abhisin98",
  "scripts": {
    "dev": "rspack serve",
    "build": "rspack build --mode=production",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",

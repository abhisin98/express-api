    "clean": "rm -rf build",
    "start": "node -r dotenv/config ./build/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@rspack/cli": "^1.5.3",
    "@rspack/core": "^1.5.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "dotenv": "^17.2.2",
    "eslint": "9.35.0",
    "eslint-config-universe": "^15.0.3",
    "eslint-rspack-plugin": "^4.2.1",
    "friendly-errors-webpack-plugin": "^1.7.0",
    "run-script-webpack-plugin": "^0.2.3",
    "ts-checker-rspack-plugin": "^1.1.5",
    "typescript": "^5.9.2",
    "webpack-merge": "^6.0.1",
    "webpackbar": "^7.0.0"
